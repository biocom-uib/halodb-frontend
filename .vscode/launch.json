{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Halo_Web (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Halo_Web/manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000"
      ],
      "django": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/Halo_Web",
      "envFile": "${workspaceFolder}/Halo_Web/.env.dev",
      "console": "integratedTerminal"
    }
  ]
}
